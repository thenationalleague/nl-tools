# NL Tools — GitHub Pages cache headers
# These tell browsers to always revalidate system files rather than serving stale cached versions.
# This means deploying nl-topbar.js, nl-brand.css etc. takes effect immediately for all users
# without needing to bump ?v= query params in every tool page.
#
# Place this file at the repo ROOT. Site is served at https://nl.tools/ (repo root = domain root).

/system/*
  Cache-Control: no-cache, must-revalidate

# Actively-iterated public collection tool — always serve fresh so clubs never
# get a stale form cached between edits.
/club-contacts/*
  Cache-Control: no-cache, must-revalidate

# Club-facing sign-off pages. Same reasoning as club-contacts: clubs open these
# on a private link while we are still adjusting what gets flagged, so an edit to
# the page or to notes.json has to reach them on the next load rather than
# whenever a cache happens to expire.
/club-signoff/*
  Cache-Control: no-cache, must-revalidate

# Graphics sub-tools + their shared assets (brand-graphic.css, clubs-data.js,
# Carbona fonts, and each tool's own index.html / styles.css / app.js). These
# are referenced without ?v=, so revalidate like the system canon — edits go
# live immediately without a per-tool cache-bust or a hard refresh.
/graphics/*
  Cache-Control: no-cache, must-revalidate

# Public wellbeing section. The pages carry crisis phone numbers and external
# service links, so a corrected number or a replaced link must reach people on
# the next load, not whenever a cache happens to expire. There is no ?v= to
# bump here — these are standalone pages, not canon files.
/wellbeing/*
  Cache-Control: no-cache, must-revalidate

# Internal sketchpad for the Wellbeing section's structure and copy. Not
# indexed, and revalidated every load so a corrected seed reaches Martyn and
# Benny immediately rather than whenever a cache happens to expire. The
# X-Robots-Tag doubles up the page's own meta noindex.
/wellbeing-map/*
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow

/assets/icons/*
  Cache-Control: public, max-age=604800

/assets/crests/*
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate
