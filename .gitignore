# Personal Claude Code overrides (permission mode, etc.) — not team-wide
.claude/settings.local.json

# npm installs (local runs of scripts/, and --no-save installs in CI)
node_modules/

# Generated graphics output (scripts/build-match-graphics.js). The full set is
# ~646MB across 3,312 files and is delivered as zips, never committed.
build/

# Data-handling guardrail (see CLAUDE.md "Data handling — non-negotiable"):
# this repo is public — data exports and seed files must never be committed.
# If a legitimate non-personal data file genuinely belongs in the repo,
# force-add it deliberately with `git add -f` after checking its contents.
exported/
*.csv
*.psv
*.tsv
*.seed.json
*-seed.json
seed-*.json
# The one CSV exception: Brand Exposure answer sheets — hand-labelled sponsor
# appearance times from public broadcasts, used to score the engine (see
# system/board-exposure/README.md). Sponsor names and timestamps only; the
# no-personal-data rule is why the exception is this narrow.
!system/board-exposure/labels/*.csv

# Generated import payloads (scripts/build-fixture-seed.js and friends).
# These are RTDB import files, not repo assets — see CLAUDE.md.
build/

# The nightly pipeline's four feeds. These live in Firebase Storage under
# `data/` and are downloaded at the start of the run and uploaded at the end —
# git is not in the loop. Between them they were committed ~370 times at 9–36MB
# a go, which is most of what makes this repository 489MB to clone.
#
# ga-metrics.json is a pure build intermediate (fetch-ga-metrics.js writes it,
# rebuild-index.js reads it in the same job). The other three persist between
# runs: articles-index.json is what website-archive renders, ga-hourly.json is
# a rolling 90 days, and ga-hourly-archive.json is the only long-term record of
# hourly GA data that exists anywhere once GA4's retention window passes.
assets/data/articles-index.json
assets/data/ga-metrics.json
assets/data/ga-hourly.json
assets/data/ga-hourly-archive.json

# Astro demo site — build artefacts
site/node_modules/
site/dist/
site/.astro/

# Python bytecode. scripts/ holds importable modules since the board-exposure
# runner split its detector out, so this directory now appears on any local run.
__pycache__/
*.pyc

# Brand Exposure ingest keys. A key is a live credential that can write a match
# into the tool, and it lives in a plain file beside the references on whichever
# machine measures matches — exactly the kind of file that gets swept up by a
# stray `git add`. Matched anywhere in the tree, not just at refs/, because the
# references folder is wherever the person running the scan put it.
ingest-key.txt
**/ingest-key.txt

# Board exposure working files: the reference artwork, the videos, the reports
# and the proxies. Match footage is rights-bearing and enormous; the reports
# embed frames of it. None of it is repo content — see system/board-exposure/.
refs/
inbox/
*-report.html
*-detections.json
*-proxy.mp4
