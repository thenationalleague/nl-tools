{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && auth.token.staff === true",
      "$jwtId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['teamId','teamName','forename','registeredAt'])",
        "teamId": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "teamName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "crestUrl": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "forename": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "surnameInitial": {
          ".validate": "newData.isString() && newData.val().length <= 2"
        },
        "registeredAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "predictions": {
      ".read": "auth != null && auth.token.staff === true",
      "$jwtId": {
        ".read": "auth != null",
        "$matchday": {
          "$matchId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['home','away','submittedAt'])",
            "home": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "away": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "submittedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": false
    },
    "motm-names": {
      ".read": "auth != null && auth.token.staff === true",
      "$jwtId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['fanName'])",
        "fanName": {
          ".validate": "newData.isString() && newData.val().length <= 110"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "motm": {
      ".read": "auth != null && auth.token.staff === true",
      "$jwtId": {
        ".read": "auth != null",
        "$matchId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['playerId','teamId','submittedAt'])",
          "playerId": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "playerName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "teamId": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 280"
          },
          "submittedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
