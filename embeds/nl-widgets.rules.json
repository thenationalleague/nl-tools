{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "//": "READ SITS AT $jwtId, NOT HERE. A read at this level returns every registration and therefore every jwtId, which is what made the rest of the data enumerable — see embeds/auth-hardening-plan.md. You now have to know an id to read its record. The leaderboard used to need the whole tree; it reads the pre-computed leaderboard/ node instead.",
      "$jwtId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['teamId','teamName','forename','registeredAt'])",
        "teamId":         { ".validate": "newData.isString() && newData.val().length <= 20" },
        "teamName":       { ".validate": "newData.isString() && newData.val().length <= 80" },
        "crestUrl":       { ".validate": "newData.isString() && newData.val().length <= 400" },
        "forename":       { ".validate": "newData.isString() && newData.val().length <= 50" },
        "surnameInitial": { ".validate": "newData.isString() && newData.val().length <= 2" },
        "registeredAt":   { ".validate": "newData.isNumber()" },
        "$other":         { ".validate": false }
      }
    },

    "predictions": {
      "//": "READ SITS AT $jwtId, NOT HERE — same reason as users above. Every fan's individual scorelines lived behind a single root read, none of which is ever displayed.",
      "$jwtId": {
        ".read": "auth != null",
        "$matchday": {
          "$matchId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['home','away','submittedAt'])",
            "home":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "away":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "submittedAt": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        }
      }
    },

    "leaderboard": {
      "//": "Pre-computed standings, written only by the scheduled aggregator (admin access bypasses these rules) and read by every signed-in widget. Safe to read broadly because it holds exactly what the leaderboard already shows in public — a name, a crest, three numbers. It must never carry a jwtId: that would republish the id list this whole exercise exists to remove. scripts/build-leaderboard.js refuses to write if one appears.",
      ".read": "auth != null",
      ".write": false
    },

    "motm-names": {
      "$jwtId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['fanName'])",
        "fanName":   { ".validate": "newData.isString() && newData.val().length <= 110" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },

    "motm": {
      "$jwtId": {
        ".read": "auth != null",
        "$matchId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['playerId','teamId','submittedAt'])",
          "playerId":    { ".validate": "newData.isString() && newData.val().length <= 32" },
          "playerName":  { ".validate": "newData.isString() && newData.val().length <= 120" },
          "teamId":      { ".validate": "newData.isString() && newData.val().length <= 20" },
          "note":        { ".validate": "newData.isString() && newData.val().length <= 280" },
          "submittedAt": { ".validate": "newData.isNumber()" },
          "$other":      { ".validate": false }
        }
      }
    }
  }
}
