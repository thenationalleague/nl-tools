---
import { crestUrl, ROSE_FALLBACK } from '../lib/crests.js';

const { rows, compact = false } = Astro.props;

function bandClass(pos) {
  if (pos === 1) return 'pos-badge--champ';
  if (pos <= 3) return 'pos-badge--sf';
  if (pos <= 7) return 'pos-badge--qf';
  if (pos >= 21) return 'pos-badge--releg';
  return '';
}
---
<div class="table-wrap">
  <table class="league-table">
    <thead>
      <tr>
        <th>Pos</th>
        <th class="col-team">Club</th>
        <th>P</th>
        <th>W</th>
        <th>D</th>
        <th>L</th>
        {!compact && <th>GF</th>}
        {!compact && <th>GA</th>}
        <th>GD</th>
        <th>Pts</th>
        {!compact && <th>Form</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><span class={'pos-badge ' + bandClass(r.position)}>{r.position}</span></td>
          <td class="col-team">
            <span class="team-cell">
              <img src={crestUrl(r.team, 'thumb')} alt="" loading="lazy"
                onerror={`this.onerror=null;this.src='${ROSE_FALLBACK}'`} />
              {r.team}
            </span>
          </td>
          <td>{r.played}</td>
          <td>{r.won}</td>
          <td>{r.drawn}</td>
          <td>{r.lost}</td>
          {!compact && <td>{r.goalsFor}</td>}
          {!compact && <td>{r.goalsAgainst}</td>}
          <td>{r.goalDifference > 0 ? '+' + r.goalDifference : r.goalDifference}</td>
          <td class="col-pts">{r.points}</td>
          {!compact && (
            <td>
              <span class="form-pips">
                {String(r.form || '').split(',').filter(Boolean).map((f) => (
                  <span class={'form-pip form-pip--' + f}>{f}</span>
                ))}
              </span>
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
