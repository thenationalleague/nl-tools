---
// Vidiprinter-style results ribbon. Baked at build time; club codes come from
// clubs-meta.json. Content is duplicated once so the marquee loops seamlessly.
import weekend from '../data/results-weekend.json';
import clubsMeta from '../../../assets/data/clubs-meta.json';

const codeByName = Object.fromEntries(clubsMeta.clubs.map((c) => [c.name, c.code]));
const code = (name) => codeByName[name] || name.slice(0, 3).toUpperCase();

const items = weekend.results.map((r) => ({
  home: code(r.home),
  away: code(r.away),
  score: `${r.homeScore}–${r.awayScore}`
}));
---
<div class="score-ribbon" aria-label={'Results, ' + weekend.label}>
  <span class="score-ribbon__label">{weekend.label}</span>
  <div class="score-ribbon__viewport">
    <div class="score-ribbon__inner">
      {[0, 1].map((copy) => (
        <div class="score-ribbon__set" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((m) => (
            <span class="score-ribbon__item">
              <b>{m.home}</b><em>{m.score}</em><b>{m.away}</b>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>
