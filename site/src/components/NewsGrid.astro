---
// News island: static skeletons, hydrated in the browser from the NL CMS
// search API (build-time fetch is not possible from the build container, and
// a live fetch keeps the demo current anyway).
//
// Two layouts: the default grid, and rail={true} — an Embla-powered
// swipeable rail with arrow buttons (used on the homepage).
const { count = 8, withHero = false, rail = false } = Astro.props;
const skeletons = Array.from({ length: rail ? 4 : count });
---
{rail ? (
  <div class="embla" data-news-rail data-count={count} data-with-hero={withHero ? '1' : ''}>
    <div class="embla__viewport">
      <div class="embla__container">
        {skeletons.map(() => (
          <div class="embla__slide">
            <div class="news-card news-card--skeleton" aria-hidden="true">
              <div class="news-card__media"></div>
              <div class="news-card__body">
                <div class="sk-line" style="width: 40%"></div>
                <div class="sk-line" style="width: 90%"></div>
                <div class="sk-line" style="width: 70%"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <button class="embla__btn embla__btn--prev" type="button" aria-label="Previous stories" disabled>&larr;</button>
    <button class="embla__btn embla__btn--next" type="button" aria-label="More stories" disabled>&rarr;</button>
  </div>
) : (
  <div class="news-grid" data-news-grid data-count={count} data-with-hero={withHero ? '1' : ''}>
    {skeletons.map(() => (
      <div class="news-card news-card--skeleton" aria-hidden="true">
        <div class="news-card__media"></div>
        <div class="news-card__body">
          <div class="sk-line" style="width: 40%"></div>
          <div class="sk-line" style="width: 90%"></div>
          <div class="sk-line" style="width: 70%"></div>
        </div>
      </div>
    ))}
  </div>
)}

<script>
  import EmblaCarousel from 'embla-carousel';
  import { fetchLatest, esc, fmtDate } from '../lib/cms.js';

  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  function cardHtml(a) {
    return `
      <a class="news-card" href="${base}news/article/?slug=${encodeURIComponent(a.slug)}">
        <div class="news-card__media">
          ${a.image
            ? `<img class="news-card__img" src="${esc(a.image)}" alt="" loading="lazy" onload="this.classList.add('is-loaded')" onerror="this.style.visibility='hidden'">`
            : ''}
        </div>
        <div class="news-card__body">
          ${a.category ? `<span class="news-card__cat">${esc(a.category)}</span>` : ''}
          <h3 class="news-card__title">${esc(a.title)}</h3>
          <span class="news-card__date">${esc(fmtDate(a.published))}</span>
        </div>
      </a>`;
  }

  function fillHero(hero) {
    const heroEl = document.querySelector('[data-hero]');
    if (!heroEl || !hero) return;
    const img = heroEl.querySelector('[data-hero-img]');
    if (img && hero.image) {
      img.onload = () => img.classList.add('is-loaded');
      img.src = hero.image;
    }
    const kicker = heroEl.querySelector('[data-hero-kicker]');
    if (kicker && hero.category) kicker.textContent = hero.category;
    const title = heroEl.querySelector('[data-hero-title]');
    if (title) title.textContent = hero.title;
    const sub = heroEl.querySelector('[data-hero-sub]');
    if (sub) sub.textContent = hero.description || fmtDate(hero.published);
    const link = heroEl.querySelector('[data-hero-link]');
    if (link) link.href = base + 'news/article/?slug=' + encodeURIComponent(hero.slug);
  }

  async function hydrateGrid(grid) {
    const count = parseInt(grid.getAttribute('data-count') || '8', 10);
    const withHero = grid.getAttribute('data-with-hero') === '1';
    try {
      const articles = await fetchLatest(withHero ? count + 1 : count);
      if (withHero) fillHero(articles.shift());
      grid.innerHTML = articles.slice(0, count).map(cardHtml).join('');
    } catch (err) {
      grid.outerHTML = '<div class="news-fallback">Couldn’t reach the news service just now — refresh to try again.</div>';
    }
  }

  async function hydrateRail(rail) {
    const count = parseInt(rail.getAttribute('data-count') || '10', 10);
    const withHero = rail.getAttribute('data-with-hero') === '1';
    try {
      const articles = await fetchLatest(withHero ? count + 1 : count);
      if (withHero) fillHero(articles.shift());
      const container = rail.querySelector('.embla__container');
      container.innerHTML = articles.slice(0, count)
        .map((a) => `<div class="embla__slide">${cardHtml(a)}</div>`).join('');

      const embla = EmblaCarousel(rail.querySelector('.embla__viewport'), {
        align: 'start',
        containScroll: 'trimSnaps',
        dragFree: false
      });
      const prev = rail.querySelector('.embla__btn--prev');
      const next = rail.querySelector('.embla__btn--next');
      const sync = () => {
        prev.disabled = !embla.canScrollPrev();
        next.disabled = !embla.canScrollNext();
      };
      prev.addEventListener('click', () => embla.scrollPrev());
      next.addEventListener('click', () => embla.scrollNext());
      embla.on('select', sync);
      embla.on('reInit', sync);
      sync();
    } catch (err) {
      rail.outerHTML = '<div class="news-fallback">Couldn’t reach the news service just now — refresh to try again.</div>';
    }
  }

  // astro:page-load fires on first load and after every view-transition swap.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-news-grid]').forEach(hydrateGrid);
    document.querySelectorAll('[data-news-rail]').forEach(hydrateRail);
  });
</script>
