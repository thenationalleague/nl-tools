---
import { ClientRouter } from 'astro:transitions';
import '../styles/brand.css';
import ScoreRibbon from '../components/ScoreRibbon.astro';

const { title = 'The National League', active = '', ribbon = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const ROSE_WHITE = '/assets/crests/National%20League%20rose%20white.png';
const ROSE = '/assets/crests/National%20League%20rose.png';

const nav = [
  { href: base, key: 'home', label: 'Home' },
  { href: base + 'news/', key: 'news', label: 'News' },
  { href: base + 'table/', key: 'table', label: 'Table' },
  { href: base + 'fixtures/', key: 'fixtures', label: 'Fixtures' }
];
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="demo-strip">Demo build &mdash; not the live National League website</div>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href={base}>
          <img src={ROSE_WHITE} alt="" onerror={`this.onerror=null;this.src='${ROSE}'`} />
          <span class="site-header__title">The National<br />League</span>
        </a>
        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    {ribbon && <ScoreRibbon />}
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <img src={ROSE_WHITE} alt="" onerror={`this.onerror=null;this.src='${ROSE}'`} />
        <span>&copy; The National League. Demo rebuilt with Astro &mdash; news via the NL CMS API, table and fixtures from NL data.</span>
      </div>
    </footer>
  </body>
</html>
