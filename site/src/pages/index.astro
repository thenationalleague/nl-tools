---
import Base from '../layouts/Base.astro';
import NewsGrid from '../components/NewsGrid.astro';
import LeagueTable from '../components/LeagueTable.astro';
import { crestUrl, ROSE_FALLBACK } from '../lib/crests.js';
import table from '../data/table-nl.json';
import fixturesFile from '../../../assets/data/fixtures-2026-27.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Next National division matchday on or after the build date
function parseUK(d) {
  const [dd, mm, yyyy] = d.split('/');
  return `${yyyy}-${mm}-${dd}`;
}
const today = new Date().toISOString().slice(0, 10);
const upcoming = fixturesFile.fixtures
  .map(([date, division, home, away, kickoff, dazn]) => ({ date: parseUK(date), division, home, away, kickoff, dazn }))
  .filter((f) => f.division === 'National' && f.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date) || a.kickoff.localeCompare(b.kickoff));
const nextDate = upcoming.length ? upcoming[0].date : null;
const nextFixtures = upcoming.filter((f) => f.date === nextDate).slice(0, 6);
const nextDateLabel = nextDate
  ? new Date(nextDate + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })
  : '';
---
<Base title="The National League" active="home" ribbon={true}>
  <a class="hero" data-hero data-hero-link href={base + 'news/'}>
    <img class="hero__img" data-hero-img alt="" />
    <div class="hero__scrim"></div>
    <div class="hero__copy">
      <p class="kicker" data-hero-kicker>Latest</p>
      <h1 class="hero__title" data-hero-title>The National League</h1>
      <p class="hero__sub" data-hero-sub>News, tables and fixtures from the home of non-league football.</p>
      <span class="hero__link">Read more &rarr;</span>
    </div>
  </a>

  <div class="section-head">
    <h2>Latest news</h2>
    <a href={base + 'news/'}>All news &rarr;</a>
  </div>
  <NewsGrid count={10} withHero={true} rail={true} />

  <div class="section-head">
    <h2>National League table</h2>
    <a href={base + 'table/'}>Full table &rarr;</a>
  </div>
  <LeagueTable rows={table.rows.slice(0, 8)} compact={true} />
  <p class="table-meta">Snapshot {table.snapshotDate} &mdash; season {table.season}</p>

  {nextFixtures.length > 0 && (
    <>
      <div class="section-head">
        <h2>Next up &mdash; {nextDateLabel}</h2>
        <a href={base + 'fixtures/'}>All fixtures &rarr;</a>
      </div>
      <div class="fixture-list">
        {nextFixtures.map((f) => (
          <div class="fixture-row">
            <span class="home">
              {f.home}
              <img src={crestUrl(f.home, 'thumb')} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${ROSE_FALLBACK}'`} />
            </span>
            <span class="ko">{f.kickoff}</span>
            <span class="away">
              <img src={crestUrl(f.away, 'thumb')} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${ROSE_FALLBACK}'`} />
              {f.away}
            </span>
            {f.dazn ? <span class="badge-dazn">DAZN</span> : <span></span>}
          </div>
        ))}
      </div>
    </>
  )}
</Base>
