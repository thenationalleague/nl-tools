---
import Base from '../../layouts/Base.astro';
import LeagueTable from '../../components/LeagueTable.astro';
import table from '../../data/table-nl.json';
---
<Base title="Table — The National League" active="table">
  <p class="kicker">Season {table.season}</p>
  <h1 class="page-title">National League table</h1>
  <p class="page-intro">Data snapshot baked at build time from NL data &mdash; {table.snapshotDate}. The production build would refresh this on every deploy and live-update it client-side.</p>
  <LeagueTable rows={table.rows} />
  <div class="table-legend">
    <span><i style="background: var(--pos-champ)"></i> Champions &mdash; promoted</span>
    <span><i style="background: var(--pos-sf)"></i> Play-off semi-finals</span>
    <span><i style="background: var(--pos-qf)"></i> Play-off qualifying</span>
    <span><i style="background: var(--pos-r-bg)"></i> Relegation</span>
  </div>
</Base>
