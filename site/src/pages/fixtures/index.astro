---
import Base from '../../layouts/Base.astro';
import { crestUrl, ROSE_FALLBACK } from '../../lib/crests.js';
import fixturesFile from '../../../../assets/data/fixtures-2026-27.json';

function parseUK(d) {
  const [dd, mm, yyyy] = d.split('/');
  return `${yyyy}-${mm}-${dd}`;
}

const today = new Date().toISOString().slice(0, 10);
const upcoming = fixturesFile.fixtures
  .map(([date, division, home, away, kickoff, dazn]) => ({ date: parseUK(date), division, home, away, kickoff, dazn }))
  .filter((f) => f.division === 'National' && f.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date) || a.kickoff.localeCompare(b.kickoff));

// Next four matchdays
const days = [];
for (const f of upcoming) {
  let day = days.find((d) => d.date === f.date);
  if (!day) {
    if (days.length === 4) break;
    day = { date: f.date, fixtures: [] };
    days.push(day);
  }
  day.fixtures.push(f);
}

const dayLabel = (date) =>
  new Date(date + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Fixtures — The National League" active="fixtures">
  <p class="kicker">Season {fixturesFile.season}</p>
  <h1 class="page-title">Fixtures</h1>
  <p class="page-intro">The next four National League matchdays. The production build would cover all three divisions with live score updates on matchdays.</p>
  {days.map((day) => (
    <section class="fixture-day">
      <h3>{dayLabel(day.date)}</h3>
      <div class="fixture-list">
        {day.fixtures.map((f) => (
          <div class="fixture-row">
            <span class="home">
              {f.home}
              <img src={crestUrl(f.home, 'thumb')} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${ROSE_FALLBACK}'`} />
            </span>
            <span class="ko">{f.kickoff}</span>
            <span class="away">
              <img src={crestUrl(f.away, 'thumb')} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${ROSE_FALLBACK}'`} />
              {f.away}
            </span>
            {f.dazn ? <span class="badge-dazn">DAZN</span> : <span></span>}
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>
