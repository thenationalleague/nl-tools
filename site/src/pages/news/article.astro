---
import Base from '../../layouts/Base.astro';
---
<Base title="Article — The National League" active="news">
  <div class="read-progress" data-read-progress></div>
  <article data-article>
    <p class="kicker" data-article-cat>News</p>
    <h1 class="page-title" data-article-title>Loading&hellip;</h1>
    <p class="article-meta" data-article-meta></p>
    <button class="share-btn" data-share hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.5" x2="15.4" y2="6.5"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/></svg>
      <span>Share</span>
    </button>
    <img class="article-hero" data-article-hero alt="" hidden />
    <div class="article-body" data-article-body></div>
  </article>
</Base>

<script>
  import { fetchArticle, renderBody, articleHero, fmtDate, esc } from '../../lib/cms.js';

  // astro:page-load fires on first load and after every view-transition swap,
  // so the slug is re-read on each navigation to this page.
  document.addEventListener('astro:page-load', async () => {
    const titleEl = document.querySelector('[data-article-title]');
    const bodyEl = document.querySelector('[data-article-body]');
    if (!titleEl || !bodyEl) return;

    const params = new URLSearchParams(location.search);
    const slug = params.get('slug') || '';
    if (!slug) {
      titleEl.textContent = 'Article not found';
      return;
    }
    try {
      const body = await fetchArticle(slug);
      if (!body) throw new Error('empty body');
      const meta = body[0] || {};
      const title = meta.postTitle || slug.split('/').pop().replace(/-\d+$/, '').replace(/-/g, ' ');
      titleEl.textContent = title;
      document.title = title + ' — The National League';

      const catEl = document.querySelector('[data-article-cat]');
      if (meta.newsCategory) catEl.textContent = meta.newsCategory;

      const metaEl = document.querySelector('[data-article-meta]');
      const bits = [];
      if (meta.postAuthor) bits.push(esc(meta.postAuthor.trim()));
      if (meta.publishedDateTime) bits.push(esc(fmtDate(meta.publishedDateTime)));
      metaEl.innerHTML = bits.join(' &middot; ');

      const heroUrl = articleHero(body);
      if (heroUrl) {
        const heroEl = document.querySelector('[data-article-hero]');
        heroEl.src = heroUrl;
        heroEl.hidden = false;
        heroEl.onerror = () => { heroEl.hidden = true; };
      }

      bodyEl.innerHTML = renderBody(body);

      const shareBtn = document.querySelector('[data-share]');
      if (shareBtn) {
        shareBtn.hidden = false;
        const label = shareBtn.querySelector('span');
        shareBtn.addEventListener('click', async () => {
          try {
            if (navigator.share) {
              await navigator.share({ title, url: location.href });
            } else {
              await navigator.clipboard.writeText(location.href);
              label.textContent = 'Link copied';
              setTimeout(() => { label.textContent = 'Share'; }, 2000);
            }
          } catch (e) { /* user dismissed the share sheet */ }
        });
      }

      const bar = document.querySelector('[data-read-progress]');
      if (bar) {
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, scrollY / max) : 0) + ')';
        };
        addEventListener('scroll', update, { passive: true });
        update();
      }
    } catch (err) {
      titleEl.textContent = 'Couldn’t load this article';
      bodyEl.innerHTML = '<p class="news-fallback">The news service didn’t respond — refresh to try again.</p>';
    }
  });
</script>
