{
  "_comment": "Merge this 'predictor' subtree into the root rules in Firebase Console (Realtime Database > Rules). Anyone signed in (Anonymous Auth) can read all predictor data so the league table works. Registration is create-only: once a user's team is set, it can't be changed (this enforces the no-flipflopping requirement). Predictions are open to any authed user (KO lock is enforced client-side because RTDB rules don't know match kickoff times).",

  "rules": {
    "predictor": {
      ".read": "auth != null",

      "users": {
        "$jwtId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['teamId','teamName','forename','registeredAt'])",
          "teamId":         { ".validate": "newData.isString() && newData.val().length <= 20" },
          "teamName":       { ".validate": "newData.isString() && newData.val().length <= 80" },
          "crestUrl":       { ".validate": "newData.isString() && newData.val().length <= 400" },
          "forename":       { ".validate": "newData.isString() && newData.val().length <= 50" },
          "surnameInitial": { ".validate": "newData.isString() && newData.val().length <= 2" },
          "email":          { ".validate": "newData.isString() && newData.val().length <= 200" },
          "registeredAt":   { ".validate": "newData.isNumber()" },
          "$other":         { ".validate": false }
        }
      },

      "predictions": {
        "$jwtId": {
          "$matchday": {
            "$matchId": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['home','away','submittedAt'])",
              "home":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
              "away":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
              "joker":       { ".validate": "newData.isBoolean()" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other":      { ".validate": false }
            }
          }
        }
      }
    }
  }
}
