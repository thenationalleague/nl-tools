          ".indexOn": [
            "kickoffUTC",
            "competitionID",
            "matchPeriod",
            "homeTeamID",
            "awayTeamID"
          ]
        },
        "submissions": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [
            "clubKey",
            "matchID",
            "submittedAt",
            "submittedByRole"
          ]
        },
        "fixtures-audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null"
        },
        "submissions-audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null"
        },
        "archive": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'"
        }
      },
      "ops-club-directory": {
        "clubs": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'",
          "$clubName": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $clubName))"
          }
        },
        "audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null",
          ".indexOn": ["ts", "club"]
        }
      },
      "ops-club-data": {
        "template": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "invites": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$token": {
            ".read": true,
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "submissions": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$token": {
            ".read": "root.child('app-data/ops-club-data/invites').child($token).exists()",
            ".write": "root.child('app-data/ops-club-data/invites').child($token).exists()"
          }
        }
      },
      "ops-handbook": {
        "nodes": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".indexOn": ["ts"]
        }
      },
      "staff-tasks": {
        "items": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$taskId": {
            ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || data.child('createdBy').val() === auth.uid || data.child('assignees').child(auth.uid).exists())",
            "notes": {
              "$noteId": {
                ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('app-data/staff-tasks/items').child($taskId).child('createdBy').val() === auth.uid || root.child('app-data/staff-tasks/items').child($taskId).child('assignees').child(auth.uid).exists() || root.child('app-data/staff-tasks/items').child($taskId).child('followers').child(auth.uid).exists())"
              }
            },
            "steps": {
              "$stepId": {
                ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('app-data/staff-tasks/items').child($taskId).child('createdBy').val() === auth.uid || root.child('app-data/staff-tasks/items').child($taskId).child('assignees').child(auth.uid).exists())"
              }
            }
          }
        },
        "projects": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$projectId": {
            ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || data.child('createdBy').val() === auth.uid || data.child('members').child(auth.uid).exists())"
          }
        }
