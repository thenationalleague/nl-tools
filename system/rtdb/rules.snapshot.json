          }
        },
        "nl-assets-folders": {
          ".read": "auth != null",
          ".write": false,
          ".indexOn": [
            "parentId"
          ]
        },
        "custom-folders": {
          ".read": "auth != null",
          "$clubKey": {
            ".write": "auth != null && ($clubKey === root.child('users').child(auth.uid).child('club').val() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null",
