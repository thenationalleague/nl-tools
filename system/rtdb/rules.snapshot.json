          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "requests": {
          ".read": "auth != null",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "shared-notes": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      },
      "staff-chase-hq": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      },
      "staff-claudio": {
        "conversations": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "usage": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      },
      "staff-meeting-notes": {
        "projects": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$projectKey": {
            ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || data.child('createdBy').val() === auth.uid)"
          }
        },
        "meetings": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$meetingKey": {
            ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || data.child('ownerUid').val() === auth.uid)"
          }
        },
        "scratchpads": {
          "$meetingKey": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "share-flags": {
          "$meetingKey": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('app-data/staff-meeting-notes/meetings').child($meetingKey).child('ownerUid').val() === auth.uid)",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "actions": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$actionKey": {
            ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || data.child('ownerUid').val() === auth.uid || data.child('assigneeUid').val() === auth.uid)",
            "status": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('app-data/staff-meeting-notes/actions').child($actionKey).child('ownerUid').val() === auth.uid || root.child('app-data/staff-meeting-notes/actions').child($actionKey).child('assigneeUid').val() === auth.uid)"
            }
          }
        },
        "contacts": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      },
      "media-dazn-vip": {
        "orgs": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff')",
          "$orgName": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || (root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $orgName))",
            "name": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $orgName && newData.val() === $orgName))",
              ".validate": "newData.isString()"
            },
            "category": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $orgName && newData.val() === 'club'))",
              ".validate": "newData.isString()"
            },
            "maxVips": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $orgName && newData.val() === 5))",
              ".validate": "newData.isNumber()"
            },
            "openRequestId": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'club' && root.child('users').child(auth.uid).child('club').val() === $orgName))"
            },
            "vips": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              "$vipId": {
                ".validate": "newData.hasChild('email')",
                "name": {
                  ".validate": "newData.isString()"
                },
                "email": {
                  ".validate": "newData.isString() && newData.val().contains('@')"
                },
                "addedAt": {
                  ".validate": "newData.isNumber()"
                },
                "addedBy": {
                  ".validate": "newData.isString()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "lastVerifiedAt": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.isNumber()"
            },
            "lastVerifiedBy": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.isString()"
            }
          }
        },
        "requests": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff')",
          ".indexOn": [
            "status",
            "orgName",
            "requestedAt"
          ],
          "$reqId": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || data.child('orgName').val() === root.child('users').child(auth.uid).child('club').val())",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'club' && newData.child('orgName').val() === root.child('users').child(auth.uid).child('club').val() && ((!data.exists() && newData.child('status').val() === 'pending') || (data.exists() && data.child('status').val() === 'pending' && newData.child('status').val() === 'cancelled'))))",
            ".validate": "newData.hasChildren(['orgName', 'status', 'requestedAt'])",
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'sent' || newData.val() === 'complete' || newData.val() === 'cancelled')"
            },
            "orgName": {
              ".validate": "newData.isString()"
            },
            "orgCategory": {
              ".validate": "newData.isString()"
            },
            "requestedAt": {
              ".validate": "newData.isNumber()"
            },
            "requestedBy": {
              ".validate": "newData.hasChild('uid')"
            },
            "changes": {
              ".validate": "newData.hasChildren()"
            },
            "sentAt": {
              ".validate": "newData.isNumber()"
            },
            "sentBy": {
              ".validate": "newData.hasChild('uid')"
            },
            "completedAt": {
              ".validate": "newData.isNumber()"
            },
            "completedBy": {
              ".validate": "newData.hasChild('uid')"
            },
            "cancelledAt": {
              ".validate": "newData.isNumber()"
            },
            "cancelledBy": {
              ".validate": "newData.hasChild('uid')"
            },
            "cancelReason": {
              ".validate": "newData.isString()"
            },
            "emailDraft": {
              ".validate": "newData.hasChildren(['subject','body','to'])"
            }
          }
        },
        "audit": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff')",
          "$orgName": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('club').val() === $orgName)",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            "$ts": {
              ".validate": "newData.hasChild('summary')"
            }
          }
        }
      }
    }
  }
}
