rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /footage/{allPaths=**} {
      // Club + producer capability pages sign in anonymously: any signed-in
      // user may read, and producers may CREATE new files.
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      // Overwriting or deleting existing footage needs a real (email) account —
      // blocks anonymous vandalism; the master console runs on portal logins.
      allow update, delete: if request.auth != null && request.auth.token.email != null;
    }

    match /newsletter/library/{file} {
      // Staff tool — anonymous tokens (which exist in this project for the
      // footage/UW capability pages) carry no email claim, so require one.
      allow read:  if request.auth != null && request.auth.token.email != null;
      allow write: if request.auth != null && request.auth.token.email != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Programme Packs ───────────────────────────────────────────────────
    // programme/<CODE>/<folderId>/<fileId>-<name>
    //   <CODE> = the clubs-meta 3-letter club code, or NL for the league's own
    //   folder. Deliberately the same key the portal uses, so moving this tool
    //   behind auth-guard later never has to re-path a single object.
    //
    // Read: any signed-in session. That is the product — a home club needs the
    // AWAY club's crest and squad photo, so the library is readable across all
    // 72 clubs. Sessions here are minted by the programmeAuth RTDB trigger only
    // after it has checked a passcode server-side.
    //
    // Write: only into your own club's prefix. `pClub` is a custom claim set by
    // that same trigger — a club's clubs-meta code, or '*' for an NL admin who
    // passed a portal role check. A client cannot forge it, so this is real
    // authorisation, not a UI convention. Note these sessions carry NO email
    // claim (same as the anonymous capability pages), so the catch-all below
    // never covers them.
    //
    // Delete is denied to clubs outright: the app soft-deletes by moving the
    // RTDB record into a trash node, and only the admin console (pClub '*')
    // empties it. A club cannot destroy bytes, its own or anyone else's.
    match /programme/{club}/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && (request.auth.token.pClub == club || request.auth.token.pClub == '*')
        && request.resource.size < 100 * 1024 * 1024
        && !request.resource.contentType.matches('application/x-.*')
        && !request.resource.contentType.matches('text/html');

      allow delete: if request.auth != null && request.auth.token.pClub == '*';
    }

    match /{allPaths=**} {
      allow read:  if request.auth != null && request.auth.token.email != null;
      allow write: if false;
    }
  }
}
