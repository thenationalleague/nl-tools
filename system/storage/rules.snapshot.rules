// Firebase Storage rules — DEPLOYED SNAPSHOT (nl-tools.firebasestorage.app)
//
// Same contract as system/rtdb/rules.snapshot.json: this file mirrors what
// is pasted into Firebase console → Storage → Rules. Edit it in the same PR
// as any change that needs new Storage paths, and tell the user to paste
// the WHOLE document into the console. Sessions cannot read the live rules —
// if it matters, ask the user to verify in the console.
//
// Paths in use:
//   footage/**            Cup Footage tool uploads (pre-existing)
//   newsletter/library/** Newsletter shared image library (images ≤5MB,
//                         written by any signed-in user, downscaled
//                         client-side to 1,600px long edge before upload)

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /footage/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }
    match /newsletter/library/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
